# Client-side (Vite) - used in browser
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-side - service role key (sensitive)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI / Third-party keys
# GROQ_API_KEY=

# One-time admin bootstrap (optional). When both are set, the login screen
# creates this admin account once. Leave unset in normal operation. Password
# must be at least 12 characters. There is NO default admin password.
# ADMIN_SETUP_EMAIL=
# ADMIN_SETUP_PASSWORD=

# Lead webhook secrets
# GOOGLE_ADS_WEBHOOK_KEY=   # required — the Google Ads webhook rejects all requests until set
# META_PAGE_ACCESS_TOKEN=
# META_VERIFY_TOKEN=        # used for the Meta webhook GET handshake
# META_APP_SECRET=          # strongly recommended — verifies X-Hub-Signature-256 on Meta lead POSTs

# Number of reverse proxies in front of the app (if you add rate limiting, etc.)
# TRUST_PROXY_HOPS=1
